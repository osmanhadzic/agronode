DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agronode

TSDB_HOST=timescaledb
TSDB_PORT=5432
TSDB_USER=postgres
TSDB_PASSWORD=postgres
TSDB_NAME=agronode_ts

MQTT_BROKER=tcp://mosquitto:1883
MQTT_TOPIC=agronode/#

BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- Phase 2: secure device provisioning (placeholders only) ---
# Backend's own broker account (required by docker-compose.secure.yml)
MQTT_USERNAME=agronode-backend
MQTT_PASSWORD=change-me
MQTT_CA_FILE=
# Internal-only listener for VerneMQ auth/ACL webhooks (never publish this port)
VERNEMQ_WEBHOOK_ADDR=:9090
# Set to false ONLY for local development without TLS
DEVICE_REGISTRATION_REQUIRE_HTTPS=true
DEVICE_REGISTRATION_RATE_LIMIT_PER_MIN=10
